# 行尾约定：仓库内统一 LF 存储。
# Windows 的 .bat 必须是 CRLF（某些编辑器/工具对此敏感），
# 而 .sh 一旦带 CRLF，在 Linux/macOS 上会以 `#!/usr/bin/env sh\r` 失败。
* text=auto eol=lf

*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf
*.sh    text eol=lf
Dockerfile text eol=lf

# 二进制/大文件不做行尾转换
*.npz   binary
*.npy   binary
*.pt    binary
*.pkl   binary
*.png   binary
*.jpg   binary
*.pdf   binary
*.docx  binary
*.pptx  binary
*.xlsx  binary
*.mp4   binary
*.mp3   binary
